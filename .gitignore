# === MyWiki shared-wiki runtime artifacts ===
modules/shared-wiki/registry.json

# RAG 检索缓存（派生产物，自动生成）
wiki/.rag_index.json

# Nested sub-project (independent git repo)
stock-dashboard/

# Local Obsidian vault mapping (machine-specific, contains absolute paths)
config/obsidian.json

# Context collector credentials (contains API secrets — never commit)
config/collect_context.json

# AI 生成的图片（派生产物）
generated-images/

# CodeBuddy 自动化运行记忆（本机运行态，非仓库产物）
.codebuddy/

# Qoder 工具缓存（本机运行态，非仓库产物）
.qoder/

# 采集器本机运行态（退避状态 / dedup 索引 / 运行日志，非仓库产物）
config/.collect_*

# 自动备份快照（运行时产物，不入库）
backups/

# 本机会话缓存（含绝对路径/会话数据，非仓库产物）
.mimosa/

# 临时验证脚本（本地调试用，不入库）
_verify_*.py
_verify_*.log

# Agent 工具工作目录（本地工具产物，不入库）
.codely/
.zion-mcp/
.codely-cli/auto-saves/

# 快速捕捉收件箱（运行时写入，按需归档）
inbox/

# 图标替换时的旧版本备份（本地保留，不进仓库）
.icons-backup*

# playwright-cli 快照工作目录（UI 验证时写入，不入库）
.playwright-cli/
